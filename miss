        </div>

    </div>



    <div class="kpi">

        <div class="kpi-label">
            🔑 UNIQUE AUTHOR KEYWORDS
        </div>

        <div class="kpi-value">
            18,908
        </div>

        <div class="kpi-small">
            Author Keywords
        </div>

    </div>



    <div class="kpi">

        <div class="kpi-label">
            📅 YEAR RANGE
        </div>

        <div class="kpi-value">
