        <div class="group-area ai"></div>

        <div class="group-area vision"></div>

        <div class="group-area data"></div>

        <div class="group-area tech"></div>



        <!-- GROUP LABELS -->

        <div class="group-label ai">
            🌸 AI & Learning
        </div>

        <div class="group-label vision">
            🌼 Vision & Language
        </div>

        <div class="group-label data">
            🌻 Data & Computing
        </div>

        <div class="group-label tech">
            🌷 Emerging Technology
        </div>



        <!-- BUTTERFLIES -->

        <div class="butterfly butterfly-1">
            🦋
        </div>

        <div class="butterfly butterfly-2">
            🦋
        </div>

        <div class="butterfly butterfly-3">
            🦋
        </div>

        <div class="butterfly butterfly-4">
            🦋
        </div>

        <div class="butterfly butterfly-5">
            🦋
        </div>



        <!-- SVG CONNECTIONS -->

        <svg
            id="connectionLayer"
            class="connection-layer">
        </svg>



        <!-- FLOWERS -->

        <div
            id="flowerNodes">
        </div>



