                        );


                    el.style.filter=

                        "drop-shadow("
                        +
                        "0 0 14px "
                        +
                        "rgba(255,185,75,.85)"
                        +
                        ")";

                }

            );


            nodesBox.appendChild(
                el
            );


        }

    );


    const edges=[

        ["artificial intelligence","machine learning",5],
        ["artificial intelligence","deep learning",5],
        ["artificial intelligence","computer vision",4],
        ["artificial intelligence","natural language processing",4],
        ["machine learning","deep learning",5],
        ["machine learning","classification",4],
        ["machine learning","prediction",4],
        ["machine learning","feature extraction",3],
        ["deep learning","neural networks",5],
        ["deep learning","computer vision",4],
        ["computer vision","image processing",4],
        ["neural networks","classification",3],
        ["internet of things","cloud computing",4],
        ["internet of things","big data",3],
        ["big data","data mining",4],
        ["data mining","classification",3],
        ["transformer","large language models",5],
        ["natural language processing","large language models",4],
        ["optimization","prediction",3],
        ["algorithm","optimization",4]

    ];


    function draw(){

        const rect=
            field.getBoundingClientRect();


        const width=
            rect.width;


        const height=
            rect.height;


        svg.setAttribute(
            "viewBox",
            `0 0 ${width} ${height}`
        );


        svg.innerHTML="";


        edges.forEach(

            edge=>{

                const a=
                    positionMap[
                        edge[0]
                    ];


                const b=
                    positionMap[
                        edge[1]
                    ];


                if(!a || !b)
                    return;


                const line=
                    document.createElementNS(

                        "http://www.w3.org/2000/svg",

                        "line"

                    );


                line.setAttribute(
                    "x1",
                    a[0]/100*width
                );


                line.setAttribute(
                    "y1",
                    a[1]/100*height
                );


                line.setAttribute(
                    "x2",
                    b[0]/100*width
                );


                line.setAttribute(
                    "y2",
                    b[1]/100*height
                );


                line.setAttribute(

                    "class",

                    edge[2]>=4
                    ?
                    "connection strong"
                    :
                    "connection"

                );


                svg.appendChild(
                    line
                );

            }

        );

    }


    setTimeout(
        draw,
        200
    );


    window.addEventListener(
        "resize",
