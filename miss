<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>
AI Research Flower Garden
</title>

<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>


<style>

/* =========================================================
   GLOBAL
========================================================= */

*{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    margin:0;

    font-family:
        Arial,
        "Noto Sans Thai",
        sans-serif;

    background:#f5f8f2;

    color:#405442;

}


/* =========================================================
   HEADER
========================================================= */

.header{

    position:relative;

    overflow:hidden;

    padding:34px 32px;

    background:

        radial-gradient(
            circle at 8% 20%,
            rgba(255,255,255,.85),
            transparent 21%
        ),

        radial-gradient(
            circle at 92% 30%,
            rgba(255,255,255,.75),
            transparent 22%
        ),

        linear-gradient(
            135deg,
            #dff1d8 0%,
            #fffdf2 48%,
            #e5f1dc 100%
        );

    border-bottom:
        1px solid #d8e4d3;

}


.header-inner{

    position:relative;

    z-index:3;

    max-width:1450px;

    margin:auto;

}


.header h1{

    margin:0;

    font-size:34px;

    font-weight:800;

    color:#38543d;

}


.subtitle{

    margin-top:8px;

    font-size:14px;

    color:#788578;

}


/* header butterflies */

.header-butterfly{

    position:absolute;

    pointer-events:none;

    user-select:none;

    opacity:.75;

    animation:
        headerFly
        6s
        ease-in-out
        infinite;

}


.header-butterfly.one{

    left:7%;

    top:20px;

    font-size:34px;

}


.header-butterfly.two{

    right:9%;

    top:35px;

    font-size:28px;

    animation-delay:1.4s;

}


.header-flower{

    position:absolute;

    pointer-events:none;

    opacity:.35;

}


.hf1{

    left:20%;

    bottom:-5px;

    font-size:35px;

}


.hf2{

    right:25%;

    bottom:-4px;

    font-size:30px;

}


@keyframes headerFly{

    0%,100%{

        transform:
            translate(0,0)
            rotate(-5deg);

    }

    50%{

        transform:
            translate(13px,-11px)
            rotate(6deg);

    }

}


/* =========================================================
   MAIN
========================================================= */

.container{

    max-width:1450px;

    margin:auto;

    padding:22px;

}


/* =========================================================
   KPI
========================================================= */

.kpis{

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:15px;

    margin-bottom:20px;

}


.kpi{

    position:relative;

    overflow:hidden;

    padding:20px;

    background:#fff;

    border:
        1px solid #dce7d7;

    border-radius:18px;

    box-shadow:
        0 5px 18px
        rgba(65,90,65,.07);

}


.kpi::after{

    content:"🌼";

    position:absolute;

    right:13px;

    bottom:5px;

    font-size:32px;

    opacity:.13;

}


.kpi-label{

    font-size:12px;

    color:#89948a;

}


.kpi-value{

    margin-top:6px;

    font-size:29px;

    font-weight:800;

    color:#426a48;

}


.kpi-small{

    margin-top:4px;

    font-size:12px;

    color:#9aa39b;

}


/* =========================================================
   GRID
========================================================= */

.grid{

    display:grid;

    grid-template-columns:
        1fr 1fr;

    gap:20px;

}


.full{

    grid-column:1/-1;

}


/* =========================================================
   CARD
========================================================= */

.card{

    overflow:hidden;

    background:#fff;

    border:
        1px solid #dce7d7;

    border-radius:18px;

    box-shadow:
        0 5px 18px
        rgba(65,90,65,.07);

}


.card-head{

    position:relative;

    padding:18px 20px;

    border-bottom:
        1px solid #e8eee5;

}


.card-title{

    font-size:17px;

    font-weight:800;

}


.card-sub{

    margin-top:4px;

    font-size:12px;

    color:#8a968b;

}


.card-flower{

    position:absolute;

    right:18px;

    top:13px;

    font-size:25px;

    opacity:.75;

}


.plot{

    height:500px;

}


/* =========================================================
   FLOWER FIELD
========================================================= */

.flower-field{

    position:relative;

    height:760px;

    overflow:hidden;

    background:

        radial-gradient(
            circle at 12% 22%,
            rgba(255,255,255,.75),
            transparent 19%
        ),

        radial-gradient(
            circle at 82% 23%,
            rgba(255,255,255,.70),
            transparent 20%
        ),

        linear-gradient(
            180deg,
            #eef8e9 0%,
            #e4f1db 52%,
            #d8e9cf 100%
        );

}


/* =========================================================
   FIELD TITLE
========================================================= */

.field-title{

    position:absolute;

    z-index:30;

    left:50%;

    top:17px;

    transform:
        translateX(-50%);

    padding:
        8px 18px;

    background:
        rgba(255,255,255,.78);

    border:
        1px solid
        rgba(210,224,204,.9);

    border-radius:30px;

    font-size:12px;

    color:#5c705e;

    backdrop-filter:
        blur(5px);

}


/* =========================================================
   BUTTERFLIES
========================================================= */

.butterfly{

    position:absolute;

    z-index:15;

    pointer-events:none;

    user-select:none;

    filter:
        drop-shadow(
            0 4px 5px
            rgba(70,80,60,.12)
        );

    animation:
        butterflyFloat
        5.5s
        ease-in-out
        infinite;

}


.butterfly-1{

    left:7%;

    top:13%;

    font-size:38px;

}


.butterfly-2{

    right:8%;

    top:17%;

    font-size:32px;

    animation-delay:1.1s;

}


.butterfly-3{

    left:13%;

    bottom:14%;

    font-size:28px;

    animation-delay:2s;

}


.butterfly-4{

    right:14%;

    bottom:13%;

    font-size:39px;

    animation-delay:.7s;

}


.butterfly-5{

    left:47%;

    top:8%;

    font-size:23px;

    animation-delay:1.8s;

}


@keyframes butterflyFloat{

    0%,100%{

        transform:
            translate(0,0)
            rotate(-5deg);

    }

    50%{

        transform:
            translate(13px,-15px)
            rotate(6deg);

    }

}


/* =========================================================
   FLOWER NODES
========================================================= */

.flower-node{

    position:absolute;

    z-index:10;

    transform:
        translate(-50%,-50%);

    display:flex;

    flex-direction:column;

    align-items:center;

    cursor:pointer;

    user-select:none;

    transition:
        transform .25s ease,
        filter .25s ease;

}


.flower-node:hover{

    transform:
        translate(-50%,-50%)
        scale(1.17);

    filter:
        drop-shadow(
            0 8px 10px
            rgba(60,90,60,.20)
        );

    z-index:50;

}


.flower-emoji{

    line-height:1;

    filter:
        drop-shadow(
            0 3px 3px
            rgba(70,80,60,.14)
        );

}


.keyword-label{

    margin-top:6px;

    max-width:150px;

    padding:
        4px 9px;

    text-align:center;

    line-height:1.2;

    font-size:10px;

    color:#425744;

    background:
        rgba(255,255,255,.82);

    border:
        1px solid
        rgba(210,224,204,.85);

    border-radius:15px;

    backdrop-filter:
        blur(4px);

}


.keyword-count{

    margin-top:2px;

    font-size:9px;

    color:#7e8d7f;

}


/* =========================================================
   FLOWER FIELD GROUP AREAS
========================================================= */

.group-area{

    position:absolute;

    z-index:2;

    border-radius:50%;

    pointer-events:none;

}


.group-area.ai{

    width:300px;

    height:230px;

    left:18%;

    top:22%;

    background:
        radial-gradient(
            ellipse,
            rgba(255,194,215,.16),
            transparent 70%
        );

}


.group-area.vision{

    width:280px;

    height:230px;

    right:16%;

    top:24%;

    background:
        radial-gradient(
            ellipse,
            rgba(194,218,255,.17),
            transparent 70%
        );

}


.group-area.data{

    width:300px;

    height:220px;

    left:20%;

    bottom:10%;

    background:
        radial-gradient(
            ellipse,
            rgba(245,215,163,.17),
            transparent 70%
        );

}


.group-area.tech{

    width:300px;

    height:220px;

    right:17%;

    bottom:10%;

    background:
        radial-gradient(
            ellipse,
            rgba(202,232,194,.18),
            transparent 70%
        );

}


/* =========================================================
   GROUP LABELS
========================================================= */

.group-label{

    position:absolute;

    z-index:4;

    padding:
        5px 11px;

    border-radius:20px;

    font-size:10px;

    background:
        rgba(255,255,255,.66);

    border:
        1px solid
        rgba(215,225,211,.8);

    color:#718072;

    backdrop-filter:
        blur(4px);

}


.group-label.ai{

    left:22%;

    top:25%;

}


.group-label.vision{

    right:20%;

    top:27%;

}


.group-label.data{

    left:24%;

    bottom:14%;

}


.group-label.tech{

    right:21%;

    bottom:14%;

}


/* =========================================================
   CONNECTIONS
========================================================= */

.connection-layer{

    position:absolute;

    inset:0;

    width:100%;

    height:100%;

    z-index:5;

    pointer-events:none;

}


.connection{

    fill:none;

    stroke-linecap:round;

    stroke:#91a989;

    stroke-opacity:.23;

    stroke-width:1.4;

}


.connection.strong{

    stroke:#6f956d;

    stroke-opacity:.38;

    stroke-width:2;

}


/* =========================================================
   FEATURE LEGEND
========================================================= */

.flower-legend{

    position:absolute;

    left:18px;

    bottom:17px;

    z-index:25;

    padding:
        10px 13px;

    border-radius:16px;

    background:
        rgba(255,255,255,.78);

    border:
        1px solid
        rgba(210,224,204,.85);

    backdrop-filter:
        blur(5px);

    font-size:10px;

    line-height:1.75;

    color:#627163;

}


/* =========================================================
   CO-OCCURRENCE GARDEN
========================================================= */

.co-field{

    position:relative;

    height:720px;

    overflow:hidden;

    background:

        radial-gradient(
            circle at 50% 48%,
            rgba(255,255,255,.82),
            transparent 28%
        ),

        radial-gradient(
            circle at 17% 22%,
            rgba(255,220,234,.20),
            transparent 24%
        ),

        radial-gradient(
            circle at 83% 25%,
            rgba(211,231,255,.20),
            transparent 24%
        ),

        linear-gradient(
            180deg,
            #f6fbf2,
            #e8f3e1
        );

}


/* =========================================================
   CO-OCCURRENCE GROUPS
========================================================= */

.co-group{

    position:absolute;

    z-index:1;

    transform:
        translate(-50%,-50%);

    display:flex;

    align-items:center;

    justify-content:center;

    border-radius:50%;

}


.co-group::before{

    content:"";

    position:absolute;

    inset:0;

    border-radius:50%;

    border:
        1px dashed
        rgba(130,160,125,.28);

}


.co-group.ai{

    width:300px;

    height:300px;

    left:25%;

    top:47%;

    background:
        radial-gradient(
            circle,
            rgba(255,202,221,.18),
            transparent 68%
        );

}


.co-group.vision{

    width:280px;

    height:280px;

    left:75%;

    top:45%;

    background:
        radial-gradient(
            circle,
            rgba(203,224,255,.20),
            transparent 68%
        );

}


.co-group.data{

    width:250px;

    height:250px;

    left:50%;

    top:77%;

    background:
        radial-gradient(
            circle,
            rgba(244,219,176,.18),
            transparent 68%
        );

}


/* =========================================================
   CO-OCCURRENCE FLOWERS
========================================================= */

.co-flower{

    position:absolute;

    z-index:10;

    transform:
        translate(-50%,-50%);

    display:flex;

    flex-direction:column;

    align-items:center;

    cursor:pointer;

    transition:
        transform .25s ease,
        filter .25s ease;

}


.co-flower:hover{

    transform:
        translate(-50%,-50%)
        scale(1.18);

    filter:
        drop-shadow(
            0 6px 8px
            rgba(70,90,70,.20)
        );

    z-index:30;

}


.co-flower .emoji{

    line-height:1;

    filter:
        drop-shadow(
            0 3px 3px
            rgba(80,90,70,.13)
        );

}


.co-flower .name{

    margin-top:5px;

    max-width:135px;

    padding:
        4px 8px;

    text-align:center;

    font-size:10px;

    line-height:1.2;

    color:#526253;

    background:
        rgba(255,255,255,.78);

    border-radius:13px;

    border:
        1px solid
        rgba(215,225,211,.8);

}


/* =========================================================
   CO-OCCURRENCE CENTRAL FLOWER
========================================================= */

.co-center{

    position:absolute;

    z-index:20;

    left:50%;

    top:50%;

    transform:
        translate(-50%,-50%);

    display:flex;

    flex-direction:column;

    align-items:center;

}


.co-center-flower{

    font-size:67px;

    line-height:1;

    filter:
        drop-shadow(
            0 6px 8px
            rgba(70,90,70,.15)
        );

    animation:
        centerFlower
        4s
        ease-in-out
        infinite;

}


@keyframes centerFlower{

    0%,100%{

        transform:
            rotate(-3deg)
            scale(1);

    }

    50%{

        transform:
            rotate(4deg)
            scale(1.05);

    }

}


.co-center-name{

    margin-top:7px;

    padding:
        6px 13px;

    background:
        rgba(255,255,255,.88);

    border-radius:20px;

    border:
        1px solid
        #dbe6d7;

    font-size:11px;

    font-weight:700;

    color:#526554;

}


/* =========================================================
   CURVED CONNECTIONS
========================================================= */

.co-svg{

    position:absolute;

    inset:0;

    width:100%;

    height:100%;

    z-index:6;

    pointer-events:none;

}


.co-line{

    fill:none;

    stroke:#91aa8b;

    stroke-width:1.5;

    stroke-opacity:.32;

    stroke-linecap:round;

}


.co-line.strong{

    stroke:#789a73;

    stroke-width:2.3;

    stroke-opacity:.48;

}


/* =========================================================
   CO-OCCURRENCE TITLE
========================================================= */

.co-title{

    position:absolute;

    z-index:30;

    left:50%;

    top:17px;

    transform:
        translateX(-50%);

    padding:
        8px 17px;

    border-radius:25px;

    background:
        rgba(255,255,255,.78);

    border:
        1px solid
        rgba(210,224,204,.85);

    font-size:12px;

    color:#627263;

    backdrop-filter:
        blur(5px);

}


/* =========================================================
   CO BUTTERFLIES
========================================================= */

.co-butterfly{

    position:absolute;

    z-index:25;

    pointer-events:none;

    animation:
        butterflyFloat
        5s
        ease-in-out
        infinite;

}


.co-b1{

    left:7%;

    top:17%;

    font-size:35px;

}


.co-b2{

    right:8%;

    top:14%;

    font-size:29px;

    animation-delay:1.4s;

}


.co-b3{

    right:11%;

    bottom:10%;

    font-size:36px;

    animation-delay:2.1s;

}


.co-b4{

    left:10%;

    bottom:13%;

    font-size:26px;

    animation-delay:.8s;

}


/* =========================================================
   INSIGHT
========================================================= */

.insight{

    padding:
        18px 20px;

    background:#f8fbf5;

    border-top:
        1px solid #e5ede1;

    font-size:13px;

    line-height:1.8;

    color:#617061;

}


/* =========================================================
   FOOTER
========================================================= */

footer{

    padding:30px;

    text-align:center;

    color:#8c988e;

    font-size:12px;

}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:900px){

    .kpis{

        grid-template-columns:
            repeat(2,1fr);

    }

    .grid{

        grid-template-columns:
            1fr;

    }

}


@media(max-width:600px){

    .kpis{

        grid-template-columns:
            1fr;

    }

    .container{

        padding:12px;

    }

    .flower-field{

        height:700px;

    }

    .co-field{

        height:700px;

    }

    .keyword-label{

        max-width:110px;

        font-size:9px;

    }

}

</style>

</head>


<body>


<!-- =========================================================
     HEADER
========================================================= -->

<header class="header">

    <div class="header-butterfly one">
        🦋
    </div>

    <div class="header-butterfly two">
        🦋
    </div>

    <div class="header-flower hf1">
        🌷
    </div>

    <div class="header-flower hf2">
        🌼
    </div>


    <div class="header-inner">

        <h1>
            🌱🌼 AI RESEARCH FLOWER FIELD
        </h1>

        <div class="subtitle">

