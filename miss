})();



/* =========================================================
   CO-OCCURRENCE CURVED FLOWER GARDEN
========================================================= */


(function(){


    const field=
        document.getElementById(
            "coField"
        );


    const svg=
        document.getElementById(
            "coSvg"
        );


    const flowers=
        [...field.querySelectorAll(
            ".co-flower"
        )];


    function drawCo(){

        const rect=
            field.getBoundingClientRect();


        const width=
            rect.width;


        const height=
            rect.height;


        svg.setAttribute(
            "viewBox",
            `0 0 ${width} ${height}`
        );


        svg.innerHTML="";


        /*
           Main connections to central theme.
           Curved paths instead of boxes.
        */

        flowers.forEach(

            (flower,i)=>{


                const x=
                    parseFloat(
                        flower.dataset.x
                    )
                    /
                    100*
                    width;


                const y=
                    parseFloat(
                        flower.dataset.y
                    )
                    /
                    100*
                    height;


                const cx=
                    width*.50;


                const cy=
                    height*.50;


                /*
                   Control point creates
                   a gentle curved connection.
                */

                const midX=
                    (x+cx)/2;


                const midY=
                    (y+cy)/2;


                const curve=

                    midX
                    +
                    (i%2===0
                        ? -35
                        : 35);


                const path=
                    document.createElementNS(

                        "http://www.w3.org/2000/svg",

                        "path"

                    );


                path.setAttribute(

                    "d",

                    `
                    M ${x} ${y}
                    Q ${curve} ${midY}
                      ${cx} ${cy}
                    `

                );


                path.setAttribute(

                    "class",

                    i%3===0
                    ?
                    "co-line strong"
                    :
                    "co-line"

                );


                svg.appendChild(
                    path
                );


            }

        );


        /*
           Additional connections
           between nearby flowers.
        */

        const pairs=[

            [0,1],
            [0,2],
            [1,3],
            [4,5],
            [4,6],
            [5,7],
            [8,9],
            [9,10],
            [8,10]

        ];


        pairs.forEach(

            pair=>{

                const a=
                    flowers[
                        pair[0]
                    ];


                const b=
                    flowers[
                        pair[1]
                    ];


                if(!a || !b)
                    return;


                const x1=
                    parseFloat(
                        a.dataset.x
                    )
                    /
                    100*
                    width;


                const y1=
                    parseFloat(
                        a.dataset.y
                    )
                    /
                    100*
                    height;


                const x2=
                    parseFloat(
                        b.dataset.x
                    )
                    /
                    100*
                    width;


                const y2=
                    parseFloat(
                        b.dataset.y
                    )
                    /
                    100*
                    height;


                const curveX=
                    (x1+x2)/2;


                const curveY=
                    (y1+y2)/2-30;


                const path=
                    document.createElementNS(

                        "http://www.w3.org/2000/svg",

                        "path"

                    );


                path.setAttribute(

                    "d",

                    `
                    M ${x1} ${y1}
                    Q ${curveX} ${curveY}
                      ${x2} ${y2}
                    `

                );


                path.setAttribute(
                    "class",
                    "co-line"
                );


                svg.appendChild(
                    path
                );

            }

        );

    }


    setTimeout(
        drawCo,
        200
    );


    window.addEventListener(
        "resize",
        drawCo
    );


})();



