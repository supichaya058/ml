        <div class="card-sub">
            Relative importance of research keywords
        </div>

        <div class="card-flower">
            🌸
        </div>

    </div>

    <div
        id="treemap"
        class="plot">
    </div>

</div>



<!-- =========================================================
     FEATURE VECTOR
========================================================= -->

<div class="card full">

    <div class="card-head">

        <div class="card-title">
            🌸 Feature Vector — Research Flower Field
        </div>

        <div class="card-sub">

