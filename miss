            "flower"
        );


    const nodesBox=
        document.getElementById(
            "flowerNodes"
        );


    const svg=
        document.getElementById(
            "connectionLayer"
        );


    const flowers=[

        "🌸",
        "🌼",
        "🌷",
        "🌻",
        "🌺",
        "🪻",
        "🌹",
        "🌸",
        "🌼",
        "🌷",
        "🌻",
        "🌺",
        "🪻",
        "🌹",
        "🌸",
        "🌼",
        "🌷",
        "🌻",
        "🌺",
        "🪻"

    ];


    const positions=[

        [48,43],
        [31,31],
        [67,30],
        [20,53],
        [76,51],
        [38,64],
        [59,62],
        [15,34],
        [84,35],
        [27,77],
        [71,76],
        [51,22],
        [52,80],
        [12,68],
        [88,65],
        [22,20],
        [80,20],
        [44,54],
        [64,45],
        [35,44]

    ];


    const positionMap={};


    TOP_KEYWORDS.forEach(

        (node,i)=>{

            positionMap[
                node.keyword
            ]=
                positions[i];

        }

    );


    const maxCount=
        Math.max(
            ...TOP_KEYWORDS.map(
                x=>x.count
            )
        );


    TOP_KEYWORDS.forEach(

        (node,i)=>{


            const pos=
                positions[i];


            const normalized=
                Math.sqrt(
                    node.count/
                    maxCount
                );


            const size=
                28+
                normalized*30;


            const el=
                document.createElement(
                    "div"
                );


            el.className=
                "flower-node";


            el.style.left=
                pos[0]+"%";


            el.style.top=
                pos[1]+"%";


            const flower=
                document.createElement(
                    "div"
                );


            flower.className=
                "flower-emoji";


            flower.textContent=
                flowers[
                    i%flowers.length
                ];


            flower.style.fontSize=
                size+"px";


            const label=
                document.createElement(
                    "div"
                );


            label.className=
                "keyword-label";


            label.textContent=
                node.keyword;


            const count=
                document.createElement(
                    "div"
                );


            count.className=
                "keyword-count";


            count.textContent=
                node.count.toLocaleString()
                +
                " articles";


            el.appendChild(
                flower
            );


            el.appendChild(
                label
            );


            el.appendChild(
                count
            );


            el.title=

                node.keyword
                +
                "\nArticles: "
                +
                node.count.toLocaleString();


            el.addEventListener(

                "click",

                ()=>{

                    document
                        .querySelectorAll(
                            ".flower-node"
                        )
                        .forEach(
                            x=>
